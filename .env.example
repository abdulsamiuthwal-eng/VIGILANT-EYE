# =========================================================
# VIGILANT EYE — ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your real credentials.
# =========================================================

# Flask Secret Key
SECRET_KEY=your-custom-secret-key-here

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# SMTP Email Alert Credentials (Gmail)
EMAIL_ENABLED=True
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_16_digit_gmail_app_password
RECIPIENT_EMAIL=alert_recipient@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
